# ===== Snakefile for trimming and filtering NET-seq reads =====================

# Extract UMI sequence R1R2
# The UMI is the first 12 bases of read 2. By default umi_tools assumes
# the given UMI pattern starts at the 5' end of the read. To account for
# this read 2 is provided with -I and read 1 is provided with --read2-in.
rule extract_umi:
    input:
        lambda wildcards: _get_fqs(wildcards.sample, RAW_DATA, FASTQ_DIR, full_name=True, paired=True)
    output:
        R1  = temp(PROJ + "/{sample}_R1_umi.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        R2  = temp(PROJ + "/{sample}_R2_umi.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        log = PROJ + "/logs/{sample}_extract_umi.out"
    params:
        job_name = "{sample}_umi_extract",
        cmd      = PROJ + "/pipeline/02_extract_umi.cmd",
        cmdd     = PROJ + "/pipeline",
        umi_pat  = CMD_PARAMS["umi_pattern"],
        orientation = ORIENTATION
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1, 2) # multiplier, min, max, unit=GB
    message:
        "Extracting UMIs for {wildcards.sample}"
    threads:
        1
    shell:
      """
      mkdir -p '{params.cmdd}'
      if [ -z "{params.umi_pat}" ]; then
          ln -sf {input[0]} {output.R1}
          ln -sf {input[1]} {output.R2}
          touch {output.log}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="umi_tools extract: step skipped",
    echo_cmd="umi_tools extract: step skipped, symlinks created"
)
EOF
      elif [ "{params.orientation}" = "R1" ]; then
          umi_tools extract \
            -I {input[1]} \
            --extract-method=string \
            --bc-pattern={params.umi_pat} \
            --read2-in={input[0]} \
            --read2-out={output.R1} \
            -L {output.log} \
            | gzip \
            > {output.R2}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="--read2-in=<sample_R1",
    version_cmd="pip show umi_tools | grep -E '^(Name|Version)'",
    echo_cmd="umi_tools extract -I <sample_R2.fastq.gz> --extract-method=string --bc-pattern={params.umi_pat} --read2-in=<sample_R1.fastq.gz> --read2-out=<sample_umi_R1.fastq.gz> | gzip > <sample_umi_R2.fastq.gz>"
)
EOF
      else
          umi_tools extract \
            -I {input[0]} \
            --extract-method=string \
            --bc-pattern={params.umi_pat} \
            --read2-in={input[1]} \
            --read2-out={output.R2} \
            -L {output.log} \
            | gzip \
            > {output.R1}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="--read2-in=<sample_R2",
    version_cmd="pip show umi_tools | grep -E '^(Name|Version)'",
    echo_cmd="umi_tools extract -I <sample_R1.fastq.gz> --extract-method=string --bc-pattern={params.umi_pat} --read2-in=<sample_R2.fastq.gz> --read2-out=<sample_umi_R2.fastq.gz> | gzip > <sample_umi_R1.fastq.gz>"
)
EOF
      fi
      """


# Trim reads with cutadapt
rule cutadapt:
    input:
        R1 = PROJ + "/{sample}_R1_umi.fastq" + (".gz" if config.get("compress_temp", True) else ""),
        R2 = PROJ + "/{sample}_R2_umi.fastq" + (".gz" if config.get("compress_temp", True) else "")
    output:
        R1    = temp(PROJ + "/{sample}_R1.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        R2    = temp(PROJ + "/{sample}_R2.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        stats = PROJ + "/cutadapt/{sample}_cutadapt_stats.txt"
    params:
        job_name = "{sample}_cutadapt",
        cmd      = PROJ + "/pipeline/03_cutadapt.cmd",
        cmdd     = PROJ + "/pipeline",
        args     = CMD_PARAMS["cutadapt"]
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1, 2) # multiplier, min, max, unit=GB
    message:
        "Running cutadapt on {wildcards.sample}"
    threads:
        6
    shell:
        """
        mkdir -p '{params.cmdd}'
        if [ -z "{params.args}" ]; then
            ln -sf {input.R1} {output.R1}
            ln -sf {input.R2} {output.R2}
            touch {output.stats}
            python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="cutadapt: step skipped",
    echo_cmd="cutadapt: step skipped, symlinks created"
)

EOF
        else
            python3 -m cutadapt \
              {params.args} \
              -j {threads} \
              -o {output.R1} \
              -p {output.R2} \
              {input.R1} \
              {input.R2} \
              > {output.stats}
            export CUTADAPT_VERSION="cutadapt $(cutadapt --version)"
            python - << 'EOF'
import sys, os
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="cutadapt {params.args}",
    version_string=os.environ.get("CUTADAPT_VERSION"),
    echo_cmd="cutadapt {params.args} -o <sample_trim_R1.fastq.gz> -p <sample_trim_R2.fastq.gz> <sample_R1.fastq.gz> <sample_R2.fastq.gz>"
)
EOF
        fi
        """


# Create cutadapt summary
rule cutadapt_summary:
    input:
        expand(
            PROJ + "/cutadapt/{sample}_cutadapt_stats.txt",
            sample = SAMS_UNIQ
        )
    output:
        PROJ + "/stats/" + PROJ + "_cutadapt.tsv"
    params:
        job_name = PROJ + "_cutadapt_summary"
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    message:
        "Creating " + PROJ + " cutadapt summary"
    threads:
        1
    shell:
        """
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")

import rules

rules._cutadapt_summary("{input}".split(), "{output[0]}")
EOF
        """


