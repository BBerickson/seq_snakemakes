# ===== Snakefile for removing duplicates with clumpify =====================

# Run clumpify for single-end reads
rule clumpify:
    input:
        lambda wildcards: _get_fqs(wildcards.sample, RAW_DATA, FASTQ_DIR, full_name=True, paired=PAIREDMAP[wildcards.sample])
    output:
        R1 = temp(PROJ + "/{sample}_R1_clumpify.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        R2 = temp(PROJ + "/{sample}_R2_clumpify.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        log = PROJ + "/clumpify/{sample}_clumpify.log"
    params:
        job_name = "{sample}_clumpify",
        cmd      = PROJ + "/pipeline/02_clumpify.cmd",
        cmdd     = PROJ + "/pipeline",
        groups = lambda wc, resources: max(1, min(16, resources.memory // 12)),
        args = lambda wildcards: CMD_PARAMS["clumpify"]["paired" if PAIREDMAP[wildcards.sample] else "single"],
        is_paired = lambda wildcards: PAIREDMAP[wildcards.sample],
        input_r2 = lambda wildcards, input: input[1] if len(input) > 1 else ""
    resources:
        # min bumped 15->24: OOM-killed on a real run (GSE202881 RNA-seq)
        # at MaxRSS 18.36GB against the old 15GB-floor-derived -Xmx17g
        # heap, confirmed java.lang.OutOfMemoryError in multiple worker
        # threads (BGZF-InputWorker/Thread-N) -- this got WORSE, not
        # better, after bumping threads 1->4 above (real parallelism
        # needs more concurrent memory, not less, since each thread needs
        # its own buffers), even though a different sample's job with the
        # exact same settings had already shown ~18.2-18.4GB real usage
        # before that change too. The one isolated manual test that
        # actually succeeded used -Xmx22g (real working set ~18GB plus
        # genuine headroom) -- 24GB floor matches that with a bit more
        # margin.
        memory = lambda wildcards, input: memory_estimator(input, 14, 24, 250) # multiplier, min, max=250, unit=GB
    threads:
        # bumped 1->4: clumpify's JVM spins up worker threads based on
        # auto-detected host core count, NOT the cgroup/SLURM CPU
        # allocation -- confirmed via a real run (GSE202881 RNA-seq) that
        # a sample genuinely stalled (CPU time plateaued for 90+ minutes,
        # confirmed via direct ssh+ps) under threads=1/--cpus-per-task=1,
        # while the IDENTICAL clumpify command line against the IDENTICAL
        # file completed in minutes when given 4 real cores -- the extra
        # threads were thrashing against a single allocated core rather
        # than genuinely parallelizing. Passing t={threads} below bounds
        # clumpify's own thread count to match what's actually allocated.
        4
    shell:
      """
      mkdir -p '{params.cmdd}'
      REDUCED_MEM=$(( {resources.memory} * 9 / 10))

      if [ -z "{params.args}" ]; then
          cp {input[0]} {output.R1}
          if [ "{params.is_paired}" = "True" ]; then
              cp {params.input_r2} {output.R2}
          else
              touch {output.R2}
          fi
          echo "Reads In:  0,0" >> {output.log}
          echo "Duplicates Found:  0,0" >> {output.log}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="clumpify: step skipped",
    echo_cmd="clumpify: step skipped"
)
EOF
      elif [ "{params.is_paired}" = "True" ]; then
          clumpify.sh -Xmx${{REDUCED_MEM}}g \
              groups={params.groups} \
              t={threads} \
              in1={input[0]} in2={params.input_r2} \
              out1={output.R1} out2={output.R2} \
              {params.args} 2>> {output.log}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="in1=<sample_R1",
    version_cmd="clumpify.sh --version 2>&1 | grep 'BBTools version'",
    echo_cmd="clumpify.sh groups={params.groups} {params.args} in1=<sample_R1.fastq.gz> in2=<sample_R2.fastq.gz> out1=<sample_dedup_R1.fastq.gz> out2=<sample_dedup_R2.fastq.gz>"
)
EOF
      else
          clumpify.sh -Xmx${{REDUCED_MEM}}g \
              groups={params.groups} \
              t={threads} \
              in={input[0]} \
              out={output.R1} \
              {params.args} 2>> {output.log}
          touch {output.R2}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="in=<sample_R1",
    version_cmd="clumpify.sh --version 2>&1 | grep 'BBTools version'",
    echo_cmd="clumpify.sh groups={params.groups} {params.args} in=<sample_R1.fastq.gz> out=<sample_dedup_R1.fastq.gz>"
)
EOF
      fi
      """



# Create clumpify summary
rule clumpify_summary:
    input:
        expand(
            PROJ + "/clumpify/{sample}_clumpify.log",
            sample = SAMS_UNIQ
        )
    output:
        PROJ + "/stats/" + PROJ + "_clumpify.tsv"
    params:
        job_name = PROJ + "_clumpify_summary",
        pairedmap = PAIREDMAP
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    threads:
        1
    shell:
        """
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")

import rules

rules._clumpify_summary("{input}".split(), "{output[0]}", "{params.pairedmap}")
EOF
        """


