# ====== Snakefile for trimming Ribo-seq footprints with cutadapt ============

rule cutadapt:
    input:
        lambda wildcards: (
            [PROJ + f"/{wildcards.sample}_R1_umi.fastq" + (".gz" if config.get("compress_temp", True) else "")]
            if UMI_MODE else
            _get_fqs(wildcards.sample, RAW_DATA, FASTQ_DIR, full_name=True, paired=False)
        )
    output:
        R1    = temp(PROJ + "/{sample}_R1_trim.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        R2    = temp(PROJ + "/{sample}_R2.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        stats = PROJ + "/cutadapt/{sample}_cutadapt_stats.txt"
    params:
        job_name = "{sample}_cutadapt",
        cmd      = PROJ + "/pipeline/03_cutadapt.cmd",
        cmdd     = PROJ + "/pipeline",
        args     = CMD_PARAMS["cutadapt"]["single"]
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 2, 4)
    message:
        "Running cutadapt on {wildcards.sample}"
    threads:
        8
    shell:
      """
      mkdir -p '{params.cmdd}'
      if [ -z "{params.args}" ]; then
          cp {input[0]} {output.R1}
          touch {output.R2}
          touch {output.stats}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="cutadapt: step skipped",
    echo_cmd="cutadapt: step skipped, copied through"
)
EOF
      else
          python3 -m cutadapt \
              {params.args} \
              -j {threads} \
              -o {output.R1} \
              {input[0]} \
              > {output.stats}
          touch {output.R2}
          export CUTADAPT_VERSION="cutadapt $(cutadapt --version)"
          python - << 'EOF'
import sys, os
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="cutadapt {params.args}",
    version_string=os.environ.get("CUTADAPT_VERSION"),
    echo_cmd="cutadapt {params.args} -o <sample_R1_trim.fastq.gz> <sample_umi_R1.fastq.gz>"
)
EOF
      fi
      """


# Create cutadapt summary -- this is a separate Snakemake rule DECLARATION
# from 01_UMI_cutadapt.snake's own cutadapt_summary (to avoid the same
# naming-collision risk noted above), but calls the exact same shared
# rules._cutadapt_summary() parsing logic.
rule cutadapt_summary:
    input:
        expand(
            PROJ + "/cutadapt/{sample}_cutadapt_stats.txt",
            sample = SAMS_UNIQ
        )
    output:
        PROJ + "/stats/" + PROJ + "_cutadapt.tsv"
    params:
        job_name = PROJ + "_cutadapt_summary"
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    message:
        "Creating " + PROJ + " cutadapt summary"
    threads:
        1
    shell:
        """
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")

import rules

rules._cutadapt_summary("{input}".split(), "{output[0]}")
EOF
        """
