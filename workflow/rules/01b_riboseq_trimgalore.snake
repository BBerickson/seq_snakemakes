# ====== Snakefile for trimming Ribo-seq footprints with Trim Galore ==========
# Shared by RiboSeq.smk and RiboSeq_UMI.smk -- the top-level smk file sets a
# module-level UMI_MODE bool (True in RiboSeq_UMI.smk, False in RiboSeq.smk)
# so this one file's input can pick between the raw fastq (no-UMI) and the
# UMI-extracted fastq from 01a_riboseq_umi_extract.snake (UMI variant),
# mirroring how 02a_align_bowtie.snake is already shared verbatim across
# BRUseq.smk/BRUseq_UMI.smk.

rule trim_galore:
    input:
        lambda wildcards: (
            [PROJ + f"/{wildcards.sample}_R1_umi.fastq" + (".gz" if config.get("compress_temp", True) else "")]
            if UMI_MODE else
            _get_fqs(wildcards.sample, RAW_DATA, FASTQ_DIR, full_name=True, paired=False)
        )
    output:
        # NOT the canonical {sample}_R1.fastq -- bbsplit/sortmerna still run
        # after this (see 01c_riboseq_bbsplit.snake/01d_riboseq_sortmerna.snake),
        # and sortmerna's own output is what's actually named {sample}_R1.fastq
        # (the name 02a_align_star.snake's STAR rule reads), matching this
        # repo's convention that the LAST filtering step always produces the
        # canonical name. This was a real bug until now: trim_galore's output
        # used to claim that name itself, which meant STAR read trim_galore's
        # unfiltered reads directly and bbsplit/sortmerna's filtered fastqs
        # were computed but never actually fed into alignment.
        R1    = temp(PROJ + "/{sample}_R1_trim.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        # Ribo-seq is always single-end -- R2 is an empty placeholder, same
        # convention clumpify/bbduk already use for single-end samples, so
        # the shared 02a_align_star.snake (which unconditionally declares
        # both R1 and R2 as inputs) works identically for both pipelines.
        # This placeholder is never touched again downstream, so it keeps
        # the canonical {sample}_R2.fastq name even though R1 doesn't.
        R2    = temp(PROJ + "/{sample}_R2.fastq" + (".gz" if config.get("compress_temp", True) else "")),
        report = PROJ + "/trim_galore/{sample}_trimming_report.txt"
    params:
        job_name = "{sample}_trim_galore",
        cmd      = PROJ + "/pipeline/03_trim_galore.cmd",
        cmdd     = PROJ + "/pipeline",
        outdir   = PROJ + "/trim_galore",
        args     = CMD_PARAMS["trim_galore"]["single"]
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 2, 4)
    threads:
        8
    shell:
      """
      mkdir -p '{params.cmdd}' '{params.outdir}'
      if [ -z "{params.args}" ]; then
          cp {input[0]} {output.R1}
          touch {output.R2}
          touch {output.report}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="trim_galore: step skipped",
    echo_cmd="trim_galore: step skipped, copied through"
)
EOF
      else
          trim_galore \
              {params.args} \
              --cores {threads} \
              --gzip \
              --output_dir {params.outdir} \
              {input[0]}

          # Trim Galore names outputs after the input basename -- rename to
          # this rule's fixed {sample}_R1.fastq.gz / _trimming_report.txt
          in_base=$(basename {input[0]})
          in_base="${{in_base%.fastq.gz}}"
          in_base="${{in_base%.fq.gz}}"
          mv "{params.outdir}/${{in_base}}_trimmed.fq.gz" {output.R1}
          mv "{params.outdir}/${{in_base}}.fastq.gz_trimming_report.txt" {output.report} 2>/dev/null || \
          mv "{params.outdir}/${{in_base}}.fq.gz_trimming_report.txt" {output.report}
          touch {output.R2}

          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="trim_galore active",
    version_cmd="trim_galore --version 2>&1 | grep version | head -1",
    echo_cmd="trim_galore {params.args} --cores <threads> --gzip --output_dir <outdir> <sample_umi_R1.fastq.gz>"
)
EOF
      fi
      """


rule trim_galore_summary:
    input:
        expand(
            PROJ + "/trim_galore/{sample}_trimming_report.txt",
            sample = SAMS_UNIQ
        )
    output:
        PROJ + "/stats/" + PROJ + "_trim_galore.tsv"
    params:
        job_name = PROJ + "_trim_galore_summary"
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    message:
        "Creating " + PROJ + " trim_galore summary"
    threads:
        1
    shell:
        """
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")

import rules

rules._trim_galore_summary("{input}".split(), "{output[0]}")
EOF
        """
