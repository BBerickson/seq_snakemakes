# ====== Rules for aligning reads =================================


# Align trimmed reads with bowtie2 R1 or R2
rule bowtie:
    input:
        R1 = PROJ + "/{sample}_R1.fastq" + (".gz" if config.get("compress_temp", True) else ""),
        R2 = PROJ + "/{sample}_R2.fastq" + (".gz" if config.get("compress_temp", True) else "")
    output:
        bam   = temp(PROJ + "/{sample}_" + INDEX_MAP + ".bam"),
        bai   = temp(PROJ + "/{sample}_" + INDEX_MAP + ".bam.bai"),
        stats = PROJ + "/bams/{sample}_" + INDEX_MAP + "_bowtie_stats.txt"
    params:
        job_name = "{sample}_bowtie",
        cmd      = PROJ + "/pipeline/bowtie.cmd",
        cmdd     = PROJ + "/pipeline",
        idx      = INDEX_PATH + INDEX_MAP,
        args     = lambda wildcards: CMD_PARAMS["bowtie2"]["paired" if PAIREDMAP[wildcards.sample] else "single"],
        sortname = PROJ + "/{sample}.temp",
        is_paired = lambda wildcards: PAIREDMAP[wildcards.sample]
    resources:
        memory = lambda wildcards, input: memory_estimator(input, 10, 16)
    threads:
        12
    shell:
        """
        mkdir -p '{params.cmdd}'
        
        sort_threads=4
        mem_per_thread=$(( {resources.memory} * 1024 * 60 / 100 / $sort_threads ))
        
        if [ "{params.is_paired}" = "True" ]; then
            reads="-1 {input.R1} -2 {input.R2}"
            myreads="-1 <sample_trim_R1.fastq.gz> -2 <sample_trim_R2.fastq.gz>"
        else
            reads="-U {input.R1}"
            myreads="-U <sample_trim_R1.fastq.gz>"
        fi
    
        bowtie2 \
            -p {threads} \
            -x {params.idx} \
            $reads \
            {params.args} \
            2> {output.stats} \
            | samtools sort - \
                -T {params.sortname} \
                -@ $sort_threads \
                -m "${{mem_per_thread}}M" \
                -o {output.bam}
    
        samtools index -@ $sort_threads {output.bam}
            
        if [ ! -s {params.cmd} ]; then
            bowtie2 --version 2>&1 | grep "version" | head -1 | sed 's|.*/||' >> {params.cmd}
            samtools --version 2>&1 | head -1 >> {params.cmd}
            echo "bowtie2 -x {params.idx} $myreads {params.args} | samtools sort - -T <sample.temp> -o <sample.bam>" >> {params.cmd}
            echo "samtools index <sample.bam>" >> {params.cmd}
        fi
        """



# ====== Rules for aligning reads summary =================================


# Align trimmed reads with bowtie2 summary
rule bowtie_summary:
    input:
        expand(
            PROJ + "/bams/{sample}_" + INDEX_MAP + "_bowtie_stats.txt",
            sample = SAMS_UNIQ
        )
    output:
        PROJ + "/stats/" + PROJ + "_" + INDEX_MAP + "_aligned.tsv"
    params:
        job_name = INDEX_MAP + "_bowtie_summary",
        index = INDEX_MAP
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    threads:
        1
    shell:
        """
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")

import rules

rules._bowtie_summary("{input}".split(), "{output[0]}", "{params.index}")
EOF
        """
        
                        