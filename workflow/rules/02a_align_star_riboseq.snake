# ====== Ribo-seq STAR alignment (genome + transcriptome BAM) =================
# Forked from rules/02a_align_star.snake -- adds --quantMode TranscriptomeSAM
# so riboWaltz (03b_riboWaltz.snake) has a transcript-coordinate BAM to
# calibrate P-site offsets against (riboWaltz's own recommended input; a
# genome/spliced-coordinate BAM complicates P-site placement across splice
# junctions). Forked rather than editing the shared file since RNAseq.smk's/
# star.smk's existing STAR usage doesn't need a transcriptome BAM. Every
# other STAR flag (e.g. short-read-tuned --alignEndsType EndToEnd) stays
# fully configurable via the existing CMD_PARAMS["star"]["single"] mechanism
# -- no code needed for that, it's already a plain config value.

rule star_twopass:
    input:
        R1 = lambda wildcards: PROJ + f"/{wildcards.sample}_R1.fastq" + (".gz" if config.get("compress_temp", True) else "")
    output:
        bam    = temp(PROJ + "/{sample}_" + INDEX_MAP + ".bam"),
        bai    = temp(PROJ + "/{sample}_" + INDEX_MAP + ".bam.bai"),
        tx_bam = PROJ + "/bams/{sample}_Aligned.toTranscriptome.out.bam",
        stats  = PROJ + "/bams/{sample}_Log.out",
        final  = PROJ + "/bams/{sample}_Log.final.out"
    params:
        job_name = "{sample}_star_twopass",
        cmd      = PROJ + "/pipeline/04_star_twopass.cmd",
        cmdd     = PROJ + "/pipeline",
        gtf      = config_indexes[PRIMARY_INDEX].get("GTF"),
        bam_unsorted = PROJ + "/bams/{sample}_Aligned.out.bam",
        args     = CMD_PARAMS["star"]["single"],
        out      = PROJ + "/bams/{sample}_",
        read_cmd = "--readFilesCommand gunzip -c" if config.get("compress_temp", True) else ""
    resources:
        memory = lambda wildcards, input: memory_estimator([input.R1], 20, 25, 250)
    message:
        "Running STAR alignment with two-pass mode (genome + transcriptome BAM)"
    threads:
        16
    shell:
      """
      mkdir -p '{params.cmdd}'
      sort_threads=4
      mem_per_thread=$(( {resources.memory} * 1024 * 60 / 100 / $sort_threads ))

      STAR \
        --genomeDir {INDEX_PATH} \
        --runThreadN {threads} \
        --readFilesIn {input.R1} \
        --outSAMtype BAM Unsorted \
        --quantMode TranscriptomeSAM \
        {params.read_cmd} \
        --outFileNamePrefix {params.out} \
        --sjdbGTFfile {params.gtf} \
        {params.args} \
        --twopassMode Basic

      samtools sort {params.bam_unsorted} \
          -T {params.out}tmp \
          -@ $sort_threads \
          -m "${{mem_per_thread}}M" \
          -o {output.bam}

      samtools index -@ $sort_threads {output.bam}

      rm {params.bam_unsorted}

      export STAR_VERSION="STAR $(STAR --version)"
      python - << 'EOF'
import sys, os
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_once(
    "{params.cmd}",
    version_string=os.environ.get("STAR_VERSION"),
    extra_version_cmds=["samtools --version 2>&1 | head -1"],
    echo_cmd="STAR --genomeDir <index> --readFilesIn <sample_trim_R1.fastq.gz> --outSAMtype BAM Unsorted --quantMode TranscriptomeSAM {params.read_cmd} --outFileNamePrefix <sample_> --sjdbGTFfile {params.gtf} {params.args} --twopassMode Basic\\nsamtools sort <sample_Aligned.out.bam> -T <sample.temp> -o <sample.bam>\\nsamtools index <sample.bam>"
)
EOF
      """


rule star_2pass_summary:
    input:
        expand(
            PROJ + "/bams/{sample}_Log.final.out",
            sample=SAMS_UNIQ
        )
    output:
        PROJ + "/stats/" + PROJ + "_" + INDEX_MAP + "_aligned.tsv"
    params:
        job_name = INDEX_MAP + "_star_2pass_summary",
        index = INDEX_MAP
    resources:
        memory = lambda wildcards, input: memory_estimator(input, 1, 1)
    message:
        "Summary of STAR alignments"
    threads:
        4
    shell:
        """
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import rules

rules._extract_star_log_info("{input}".split(), "{output}", "{params.index}")
EOF
        """
