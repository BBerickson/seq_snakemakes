# ====== Rules for filtering aligned reads with samtools =================================

# filter aligned reads
rule align_filter_multimap:
    input:
        bam = PROJ + "/{sample}_" + INDEX_MAP + ".bam",
        bai = PROJ + "/{sample}_" + INDEX_MAP + ".bam.bai"
    output:
        bam = temp(PROJ + "/{sample}_" + INDEX_MAP + "_multimap.bam"),
        bai = temp(PROJ + "/{sample}_" + INDEX_MAP + "_multimap.bam.bai"),
        bamt = temp(PROJ + "/{sample}_" + INDEX_MAP + "_multimap_temp.bam"),
        counts = PROJ + "/bams/{sample}_" + INDEX_MAP + "_count_multimap.txt"
    params:
        job_name = "{sample}_multimap_filter",
        cmd      = PROJ + "/pipeline/05_filter_multimap.cmd",
        cmdd     = PROJ + "/pipeline",
        samp = "{sample}_" + INDEX_MAP,
        args = CMD_PARAMS["samtools"],
        args2 = CMD_PARAMS["multimap"],
        sortname = PROJ + "/{sample}_multimap.temp",
        is_paired = lambda wildcards: PAIREDMAP[wildcards.sample]
    resources:
        memory = lambda wildcards, input: memory_estimator(input, 0.5, 2)
    threads: 
        8
    shell:
      """
      mkdir -p '{params.cmdd}'
      args2_trimmed=$(echo "{params.args2}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  
      if [ -z "$args2_trimmed" ]; then
          touch {output.bamt}
          samtools view {params.args} {input.bam} > {output.bam}
          samtools index -@ {threads} {output.bam}
          echo "{params.samp} Filtered_reads $(samtools idxstats {output.bam} | awk '{{s+=$3}} END {{print s}}')" > {output.counts}
          python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="samtools view no multimap filter",
    version_cmd="samtools --version 2>&1 | head -1",
    echo_cmd="samtools view {params.args} <sample.bam> > <sample_filter.bam>\\nsamtools index <sample_filter.bam>"
)
EOF
      else
          if [ "{params.is_paired}" = "True" ]; then
              samtools view {params.args} -u {input.bam} \
                | samtools sort -n -T {params.sortname} -@ {threads} \
                | samtools view -h - \
                | python pipelines/multimappers2.py {params.args2} --paired-end \
                | samtools fixmate -r - {output.bamt}
              samtools view -F 1804 -f 2 -u {output.bamt} \
                | samtools sort - -T {params.sortname} -@ {threads} -O bam \
                > {output.bam}
              samtools index -@ {threads} {output.bam}
              echo "{params.samp} Multimap_Filtered_reads $(samtools idxstats {output.bam} | awk '{{s+=$3}} END {{print s}}')" > {output.counts}
              python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="multimappers2 PE",
    version_cmd="samtools --version 2>&1 | head -1",
    echo_cmd="samtools view {params.args} -u <sample.bam> | samtools sort -n -T <sample.temp> | samtools view -h - | multimappers2.py {params.args2} --paired-end | samtools fixmate -r - <sample_temp.bam>\\nsamtools view -F 1804 -f 2 -u <sample_temp.bam> | samtools sort - -T <sample.temp> -O bam > <sample_filter.bam>\\nsamtools index <sample_filter.bam>"
)
EOF
          else
              samtools view {params.args} -u {input.bam} \
                | samtools sort -n -T {params.sortname} -@ {threads} \
                | samtools view -h - \
                | python pipelines/multimappers2.py {params.args2} \
                | samtools fixmate -r - {output.bamt}
              samtools view -F 1804 -u {output.bamt} \
                | samtools sort - -T {params.sortname} -@ {threads} -O bam \
                > {output.bam}
              samtools index -@ {threads} {output.bam}
              echo "{params.samp} Multimap_Filtered_reads $(samtools idxstats {output.bam} | awk '{{s+=$3}} END {{print s}}')" > {output.counts}
              python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_tagged(
    "{params.cmd}",
    tag="multimappers2 SE",
    version_cmd="samtools --version 2>&1 | head -1",
    echo_cmd="samtools view {params.args} -u <sample.bam> | samtools sort -n -T <sample.temp> | samtools view -h - | multimappers2.py {params.args2} | samtools fixmate -r - <sample_temp.bam>\\nsamtools view -F 1804 -u <sample_temp.bam> | samtools sort - -T <sample.temp> -O bam > <sample_filter.bam>\\nsamtools index <sample_filter.bam>"
)
EOF
          fi
      fi
      """
    
        
# filter aligned reads
rule align_filter_indexed:
    input:
        bam = PROJ + "/{sample}_" + INDEX_MAP + "_multimap.bam",
        bai = PROJ + "/{sample}_" + INDEX_MAP + "_multimap.bam.bai"
    output:
        bam    = PROJ + "/bams/{sample}_aligned_{index}_" + SEQ_DATE + ".bam",
        bai    = PROJ + "/bams/{sample}_aligned_{index}_" + SEQ_DATE + ".bam.bai",
        counts = PROJ + "/bams/{sample}_aligned_{index}_count.txt"
    params:
        job_name = "{sample}_align_filter_{index}",
        cmd      = PROJ + "/pipeline/06_index_filter.cmd",
        cmdd     = PROJ + "/pipeline",
        # CHROM_PATH optional override: for *_star.yaml ref families,
        # INDEX_PATH is intentionally repurposed to point at the STAR
        # genomeDir (see star.smk's own comment), not the chrom-list-txt
        # directory this rule actually needs -- confirmed via a real crash,
        # "head: cannot open .../star_idxhg38.txt" (INDEX_PATH + index +
        # ".txt" resolving into the STAR index dir, where no such file
        # exists), which silently emptied the contig filter and let samtools
        # view pass the entire unfiltered bam through, inflating real memory
        # need well past what file-size-based estimates accounted for.
        # CHROM_PATH defaults to INDEX_PATH (preserving existing behavior for
        # every non-STAR ref yaml, where the two already coincide).
        idx      = lambda wildcards: config_indexes[wildcards.index].get("CHROM_PATH", INDEX_PATH) + wildcards.index + ".txt",
        samp     = "{sample}_{index}",
        args     = CMD_PARAMS["samtools"],
        fa       = lambda wildcards: config_indexes[wildcards.index].get("FA_SAMPLE"),
        sortname = PROJ + "/{sample}_aligned_{index}.temp"
    resources:
        # min bumped 8->16->24: this small job (actual usage has ranged from
        # under 100MB to 15.69GB) kept getting OOM-killed anyway -- 4 times
        # across 2 different samples now, always with huge unrelated jobs
        # (70+GB STAR, 28GB SortMeRNA x4 samples) running concurrently on
        # shared nodes. The 15.69GB data point landed uncomfortably close to
        # the 16GB floor, so this isn't purely a scheduling-pressure fix
        # anymore either -- 24GB gives real margin on both fronts.
        # multiplier 4->6, min 24->32: after fixing a Ribo-seq adapter bug
        # elsewhere, STAR's alignment rate jumped from ~7% to ~93%, so the
        # multimap.bam input to this rule is now much larger (e.g. 6.8GB for
        # one sample, estimate ~27GB at multiplier=4) -- OOM-killed twice at
        # that size even with margin (MaxRSS 23.99GB on the 2nd attempt,
        # right at the old 24GB floor), confirming genuine data-driven
        # undersizing now, not just node contention.
        # multiplier 6->8: after also fixing a separate contig-filter bug
        # (CHROM_PATH), the 2 smaller samples succeeded fine under
        # multiplier=6, but the 2 largest (6.8GB/5.1GB multimap.bam, highest
        # read counts) still OOM-killed comfortably under their own request
        # (23.6GB/15.8GB) -- real per-sample scaling gap for the largest
        # inputs specifically, not node contention (confirmed: ran alongside
        # only a single small unrelated 8GB job on an otherwise-idle node).
        memory = lambda wildcards, input: memory_estimator(input, 8, 32) # multiplier, min, max, unit=GB
    threads: 4
    shell:
      """
      mkdir -p '{params.cmdd}'
      mem_per_thread=$(( {resources.memory} * 1024 * 80 / 100 / {threads} ))
  
      samtools view {input.bam} $(head -n1 {params.idx}) \
      | sed 's/spike_*//g' \
      | samtools view -bT {params.fa} - \
      > {params.sortname}.unsorted.bam
  
      samtools sort {params.sortname}.unsorted.bam \
          -T {params.sortname} \
          -@ {threads} \
          -m "${{mem_per_thread}}M" \
          -O bam \
          -o {output.bam}
  
      samtools index -@ {threads} {output.bam}
  
      echo "{params.samp} Filtered_reads $(samtools idxstats {output.bam} | awk '{{s+=$3}} END {{print s}}')" > {output.counts}
  
      rm -f {params.sortname}.unsorted.bam
  
      python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.write_cmd_once(
    "{params.cmd}",
    version_cmd="samtools --version 2>&1 | head -1",
    echo_cmd="samtools view <sample_filter.bam> <spike_contig> | samtools view -bT <genome.fa> - > <sample_unsorted.bam>\\nsamtools sort <sample_unsorted.bam> -T <sample.temp> -O bam -o <sample_index_filter.bam>\\nsamtools index <sample_index_filter.bam>"
)
EOF
      """
