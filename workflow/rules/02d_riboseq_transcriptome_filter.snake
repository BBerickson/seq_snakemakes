# ====== Multi-mapping resolution for STAR's transcriptome BAM (P-site/CDS) ===
rule transcriptome_multimap_filter:
    input:
        bam = PROJ + "/bams/{sample}_Aligned.toTranscriptome.out.bam"
    output:
        bam  = PROJ + "/bams/{sample}_Aligned.toTranscriptome.filtered.bam",
        bamt = temp(PROJ + "/bams/{sample}_Aligned.toTranscriptome.multimap_temp.bam")
    params:
        job_name = "{sample}_transcriptome_multimap_filter",
        sortname = PROJ + "/{sample}_transcriptome_multimap.temp"
    resources:
        memory = lambda wildcards, input: memory_estimator(input, 2, 8, 32)
    threads:
        4
    shell:
        """
        samtools view -F4 -u {input.bam} \
          | samtools sort -n -T {params.sortname} -@ {threads} \
          | samtools view -h - \
          | python workflow/scripts/multimappers2.py -k 1 \
          | samtools fixmate -r - {output.bamt}
        samtools view -F 1804 -u {output.bamt} \
          | samtools sort - -T {params.sortname} -@ {threads} -O bam \
          > {output.bam}
        """
