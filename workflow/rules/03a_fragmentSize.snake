# ====== Rules for getting read and fragment size from paired end data =================================


# fragment size of mapped paired end reads
rule fragment_size:
    input:
        bam  = PROJ + "/bams/{sample}_aligned_{index}_" + SEQ_DATE + ".bam",
        bai  = PROJ + "/bams/{sample}_aligned_{index}_" + SEQ_DATE + ".bam.bai"
    output:
        log  = temp(PROJ + "/stats/{sample}_aligned_{index}_fragment.txt"),
        pic  = temp(PROJ + "/stats/{sample}_aligned_{index}_fragmentSize.png")
    params:
        job_name = "{sample}_fragment_size_{index}",
        labels   = lambda wildcards: f"{wildcards.sample}_spike" if INDEX_ROLE.get(wildcards.index) == "spike" else wildcards.sample,
        script   = "workflow/scripts/read_size_png.R",
        args     = lambda wildcards: CMD_PARAMS["fragment_size"]["paired" if PAIREDMAP[wildcards.sample] else "single"],
        is_paired = lambda wildcards: PAIREDMAP[wildcards.sample]
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 0.2, 5)
    threads: 
        12
    shell:
        """
        if [ "{params.is_paired}" = "True" ]; then
            # Paired-end fragment size analysis. deepTools' bamPEFragmentSize
            # can crash with "ValueError: max must be larger than min in range
            # parameter" -- its histogram step does
            # plt.hist(lengths, range=(observed_min, --maxFragmentLength)),
            # which throws whenever a bam is so low-signal that every sampled
            # fragment is already >= --maxFragmentLength (e.g. a near-empty
            # spike/control bam). That's a deepTools bug (it never validates
            # the range), not something our args can prevent, and it kills
            # the whole process before --table is ever written since the
            # crash happens before printTable() is called. If it happens,
            # retry without -hist: the numeric --table stats (min/mean/etc.)
            # are computed earlier and are unaffected by the histogram code
            # path, so this still gets real per-sample stats into
            # fragment_results.tsv -- only the cosmetic PNG is faked.
            if ! bamPEFragmentSize \
                  -hist {output.pic} \
                  --numberOfProcessors {threads} \
                  -T "Fragment size of PE data" \
                  -b  {input.bam} {params.args} \
                  --samplesLabel {params.labels} \
                  --table {output.log}; then
                echo "WARNING: bamPEFragmentSize histogram failed for {params.labels} (deepTools min>=max range crash -- likely too few/short paired fragments in this bam). Retrying without the histogram so the table stats still get captured; {output.pic} will be a placeholder." >&2
                bamPEFragmentSize \
                  --numberOfProcessors {threads} \
                  -T "Fragment size of PE data" \
                  -b  {input.bam} {params.args} \
                  --samplesLabel {params.labels} \
                  --table {output.log}
                python3 -c "
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
fig, ax = plt.subplots()
ax.text(0.5, 0.5, 'histogram unavailable\n(too few/short paired fragments)', ha='center', va='center', wrap=True)
ax.axis('off')
fig.savefig('{output.pic}')
plt.close(fig)
"
            fi
        else
            # Single-end read length analysis. Was readlength.sh (BBMap),
            # but a specific CIGAR+MD combo (spliced alignment immediately
            # followed by a deletion, e.g. "13M256N1M3D16M") trips an
            # internal BBMap sanity-check hard enough to hang a worker
            # thread forever -- confirmed real once Ribo-seq alignment rates
            # got high enough for such reads to occur. Disabling assertions
            # (-da, the tool author's own suggested workaround) only swaps
            # the clean AssertionError for an uncaught
            # ArrayIndexOutOfBoundsException in the same code path, same
            # hang. Replaced with a direct samtools+awk length histogram --
            # read length is just the SEQ field's string length, no
            # CIGAR/MD reconstruction needed at all, so this sidesteps the
            # bug entirely rather than working around it. Reproduces
            # readlength.sh's exact output format (read_size_png.R parses
            # #Length/reads from line 10 on; fragment_results.R parses
            # #Avg:/#Median: from lines 5-6).
            samtools view {input.bam} \
              | awk '{{ s = $10; if (s != "*") print length(s) }}' \
              | sort -n | uniq -c \
              | awk -v OFS='\\t' '
                {{
                  c = $1; l = $2
                  count[l] = c
                  lengths[++n] = l
                  total_reads += c
                  total_bases += l * c
                  if (n == 1) minlen = l
                  maxlen = l
                  if (c > modecount) {{ modecount = c; modelen = l }}
                }}
                END {{
                  avg = total_bases / total_reads
                  half = total_reads / 2
                  cum = 0; median = -1
                  for (i = 1; i <= n; i++) {{
                    l = lengths[i]; cum += count[l]
                    if (median == -1 && cum >= half) median = l
                  }}
                  sq = 0
                  for (i = 1; i <= n; i++) {{
                    l = lengths[i]; sq += count[l] * (l - avg) * (l - avg)
                  }}
                  stddev = sqrt(sq / total_reads)

                  print "#Reads:", total_reads
                  print "#Bases:", total_bases
                  print "#Max:", maxlen
                  print "#Min:", minlen
                  printf "#Avg:\\t%.1f\\n", avg
                  print "#Median:", median
                  print "#Mode:", modelen
                  printf "#Std_Dev:\\t%.1f\\n", stddev
                  print "#Read Length Histogram:"
                  print "#Length", "reads", "pct_reads", "cum_reads", "cum_pct_reads", "bases", "pct_bases", "cum_bases", "cum_pct_bases"

                  cum_reads = 0; cum_bases = 0
                  for (i = 1; i <= n; i++) {{
                    l = lengths[i]; c = count[l]; b = l * c
                    cum_reads += c; cum_bases += b
                    printf "%d\\t%d\\t%.3f%%\\t%d\\t%.3f%%\\t%d\\t%.3f%%\\t%d\\t%.3f%%\\n", l, c, 100*c/total_reads, cum_reads, 100*cum_reads/total_reads, b, 100*b/total_bases, cum_bases, 100*cum_bases/total_bases
                  }}
                }}' > {output.log}

            Rscript {params.script} {output.log} {output.pic}
        fi
        """
  
        
rule fragment_results:
    input:
        lambda wildcards: sorted([
            PROJ + f"/stats/{sample}_aligned_{wildcards.index}_fragment.txt"
            for sample in SAMS_UNIQ
        ])
    output:
        PROJ + "/stats/" + PROJ + "_{index}_fragment_results.tsv"
    params:
        job_name = "fragment_results_{index}",
        samp     = "{index}",
        script   = "workflow/scripts/fragment_results.R"
    resources:
        memory = lambda wildcards, input: memory_estimator(input, 1, 1)
    threads: 1
    shell:
        """
        Rscript {params.script} "{input}" "{params.samp}" "{output}"
        """


rule fragment_png:
    input:
        lambda wildcards: sorted([
            PROJ + f"/stats/{sample}_aligned_{wildcards.index}_fragmentSize.png"
            for sample in SAMS_UNIQ
        ])
    output:
        PROJ + "/report/" + PROJ + "_{index}_fragmentSize.pdf"
    params:
        job_name  = "fragment_{index}_results_pdf",
        script = "workflow/scripts/pngToPDF.R",
        pdf_title = PROJ + "_{index}",
        chunkSize = 4
    resources:
        memory = lambda wildcards, input: memory_estimator(input, 1, 1)
    threads: 1
    shell:
        """
        Rscript {params.script} "{input}" "{params.chunkSize}" "{params.pdf_title}" "{output}"
        """
    
    
