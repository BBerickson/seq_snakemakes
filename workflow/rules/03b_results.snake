# ====== Rules for getting overall results =================================

# CMD_PARAMS.scalingFactors holds only the multiBamSummary mode + flags (e.g.
# "BED-file --centerReads" or "bins --binSize 100 --centerReads") -- the
# region file itself is genome-specific and lives in a ref yaml's SCALING_REF,
# not duplicated as a path here. In BED-file mode, this looks up SCALING_REF
# per-index, but prefers the spike index's SCALING_REF over the index being
# summarized (dual-IP/split-style setups use one common spike-defined region
# set to compute a shared scaling factor across both genomes' alignments,
# including the primary's) -- falls back to the index's own SCALING_REF when
# there's no spike role (e.g. plain single-genome setups).
def get_scaling_args(wildcards):
    mode_args = CMD_PARAMS.get("scalingFactors", "")
    if not mode_args.strip().startswith("BED-file"):
        return mode_args
    spike = ROLE_MAP.get("spike")
    ref_index = spike if spike else wildcards.index
    bed = config_indexes.get(ref_index, {}).get("SCALING_REF")
    if not bed:
        sys.exit(f"ERROR: CMD_PARAMS.scalingFactors is set to BED-file mode, but index '{ref_index}' has no SCALING_REF in its ref yaml.")
    return f"{mode_args} --BED {bed}"

# multiBamSummary spikein reads
rule multiBamSummary:
    input:
        bam = lambda wildcards: expand(
            PROJ + "/bams/{sample}_aligned_{index}_" + SEQ_DATE + ".bam",
            sample = GROUPS[wildcards.group],
            index = [wildcards.index]
        ),
        counts = lambda wildcards: expand(
          PROJ + "/stats/{sample}_summary_featureCounts.tsv",
            sample = GROUPS[wildcards.group]
        )
    output:
        npz  = temp(PROJ + "/bams/{group}_aligned_{index}_" + SEQ_DATE + ".npz"),
        gsf  = PROJ + "/bams/{group}_aligned_{index}_" + SEQ_DATE + "_scalefactor.txt"
    params:
        job_name = "{group}_aligned_{index}_multiBamSummary",
        index_sample = "{index}",
        labs = lambda wildcards: " ".join(GROUPS[wildcards.group]),
        args = get_scaling_args,
        script = "workflow/scripts/multiBamSummary.R"
    resources:
        memory   = lambda wildcards, input: memory_estimator(input.bam, 0.2, 5)
    threads: 
        12
    shell:
        """
        if [ -z "{params.args}" ]; then
            # No args, just make empty files
            touch {output.npz}
            touch {output.gsf}
        else
            multiBamSummary \
            {params.args} \
            --bamfiles {input.bam} \
            --labels {params.labs} \
            -p {threads} \
            --scalingFactors {output.gsf} \
            -o {output.npz}
        
          Rscript {params.script} {output.gsf} "{input.counts}" "{params.index_sample}"
        fi
          
        
        """

# calculating OR
rule calculating_OR:
    input:
        lambda wildcards: expand(
            PROJ  + "/stats/{sample}_summary_featureCounts.tsv",
            sample = SAMPIN[wildcards.newnam]
        )
    output:
        temp(PROJ + "/counts/{newnam}_OR_count.txt")
    params:
        job_name = "{newnam}_OR",
        type     = NORM,
        indexs   = INDEXES,
        script   = "workflow/scripts/count_OR.R"
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    message:
        "getting OR norm for {wildcards.newnam}"
    threads: 
        1
    shell:
        """
        Rscript {params.script} "{input}" "{params.type}" "{params.indexs}" "{output}"

        """
  
# gathering results
rule gathering_OR_results:
    input:
        expand(
        PROJ      + "/counts/{newnam}_OR_count.txt",
            newnam = NAMS_UNIQ
        )
    output:
        PROJ + "/counts/" + PROJ + "_OR_summery.tsv"
    params:
        job_name = "ORresults"
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    message:
        "getting final results"
    threads: 
        1
    shell:
        """
        cat {input} > {output}
        """
                    
# gathering results
rule gathering_results:
    input:
        clump   = PROJ + "/stats/" + PROJ + "_clumpify.tsv",
        bbduk   = PROJ + "/stats/" + PROJ + "_bbduk.tsv",
        aligned = PROJ + "/stats/" + PROJ + "_" + INDEX_MAP + "_aligned.tsv",
        fc_file = expand( PROJ + "/stats/{sample}_summary_featureCounts.tsv",
            sample = SAMS_UNIQ
        ),
        OR      = PROJ + "/counts/" + PROJ + "_OR_summery.tsv",
        SF_file = expand( PROJ + "/bams/{group}_aligned_{index}_" + SEQ_DATE + "_scalefactor.txt",
            group = GRPS_UNIQ,
            index  = INDEXES
        ),
        extra = [] if NORM != "subsample" else expand(
                    PROJ + "/stats/" + PROJ + "_{index}_subsample_frac.tsv", 
                    index=PRIMARY_INDEX
                ),
        FC_files = expand( PROJ + "/counts/{sample}_aligned_{index}_featureCounts.tsv",
            sample = SAMS_UNIQ,
            index  = PRIMARY_INDEX
        )
    output:
        PROJ + "/report/" + PROJ + "_" + PRIMARY_INDEX + "_results.tsv"
    params:
        job_name = "results",
        indexmap = INDEX_MAP,
        indexs   = INDEXES,
        sam_new  = SAMPLES,
        project  = PROJ,
        filterty = CMD_PARAMS["filter_results"],
        script = "workflow/scripts/results.R"
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    message:
        "getting final results"
    threads: 
        1
    shell:
        """
        Rscript {params.script} "{input.clump}" "{input.bbduk}" "{input.aligned}" "{input.fc_file}" "{input.FC_files}" "{params.indexmap}" "{params.indexs}" "{params.sam_new}" "{params.project}" "{params.filterty}" "{output}"

        """
  
rule create_plots:
    input:
        PROJ + "/report/" + PROJ + "_" + PRIMARY_INDEX + "_results.tsv"
    output:
        report  = SEQ_DATE + "_" + PROJ + "_" + PRIMARY_INDEX + "_qc_analysis.html",
        reportc = PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_pipeline_methods.txt",
        config  = temp(PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_" + PRIMARY_INDEX + "_config.yaml"),
        result  = temp(PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_" + PRIMARY_INDEX + "_clean_results.tsv")
    params:
        job_name  = PROJ + "_qc_html",
        cmdd     = PROJ + "/pipeline",
        out_file  = SEQ_DATE + "_" + PROJ + "_" + PRIMARY_INDEX + "_qc_analysis",
        script  = "workflow/scripts/multiqc_config.R",
        seqdate = SEQ_DATE,
        mydir   = PROJ,
        index   = PRIMARY_INDEX
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1) # multiplier, min, max, unit=GB
    threads:
        1
    shell:
        """
        echo "Pipeline run: $(date '+%Y-%m-%d %H:%M:%S')" >> {output.reportc}
        echo "" >> {output.reportc}
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.aggregate_cmds("{params.cmdd}", "{output.reportc}")
EOF
        Rscript {params.script} "{input}" "{params.mydir}" "{params.seqdate}" "{params.index}" "{output.result}" "{output.config}"
        multiqc {params.mydir} --config {output.config} --force --filename {params.out_file}
        rm -r {params.out_file}_data
        rm -f {PROJ}/pipeline/*.lock
        """
     