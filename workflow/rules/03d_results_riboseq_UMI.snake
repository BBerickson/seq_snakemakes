# ====== Overall results (Ribo-seq, UMI variant) ===============================
# Same shape as 03d_results_riboseq.snake, but passes the real UMI-tools
# dedup summary tsv as results_riboseq.R's dedup arg.

rule gathering_results:
    input:
        cutadapt    = PROJ + "/stats/" + PROJ + "_cutadapt.tsv",
        aligned     = PROJ + "/stats/" + PROJ + "_" + INDEX_MAP + "_aligned.tsv",
        dedup       = PROJ + "/stats/" + PROJ + "_" + INDEX_MAP + "_UMI_dedup.tsv",
        fc_file     = expand(PROJ + "/stats/{sample}_summary_featureCounts.tsv", sample = SAMS_UNIQ),
        ribowaltz   = PROJ + "/stats/" + PROJ + "_ribowaltz_psite.tsv",
        # results_riboseq.R reads this via its own list.files() glob, not a
        # declared argument -- see 03d_results_riboseq.snake's identical
        # comment for why this needs to be an explicit input.
        fragment_results = PROJ + "/stats/" + PROJ + "_" + PRIMARY_INDEX + "_fragment_results.tsv",
        extra = [] if NORM != "subsample" else expand(
                    PROJ + "/stats/" + PROJ + "_{index}_subsample_frac.tsv",
                    index=PRIMARY_INDEX
                ),
        FC_files = expand(PROJ + "/counts/{sample}_aligned_{index}_featureCounts.tsv",
            sample = SAMS_UNIQ, index = PRIMARY_INDEX)
    output:
        PROJ + "/report/" + PROJ + "_" + PRIMARY_INDEX + "_results.tsv"
    params:
        job_name = "results",
        indexmap = INDEX_MAP,
        indexs   = INDEXES,
        sam_new  = SAMPLES,
        project  = PROJ,
        filterty = CMD_PARAMS["filter_results"],
        script = "workflow/scripts/results_riboseq.R"
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1)
    message:
        "getting final results"
    threads:
        1
    shell:
        """
        Rscript {params.script} "{input.cutadapt}" "{input.aligned}" "{input.dedup}" "{input.fc_file}" "{input.FC_files}" "{params.indexmap}" "{params.indexs}" "{params.sam_new}" "{params.project}" "{params.filterty}" "{output}"
        """


rule create_plots:
    input:
        tsv = PROJ + "/report/" + PROJ + "_" + PRIMARY_INDEX + "_results.tsv",
        # multiqc scans {params.mydir} recursively once this rule runs, so
        # any PNGs that should be swept into the report (differential
        # occupancy's "..._aligned_{index}__..." images) must already exist
        # -- an explicit dependency here, not just both being in rule all's
        # input list, which alone wouldn't guarantee this rule runs last.
        extra = [] if not CONTRASTS else [
            expand(PROJ + "/report/{contrast}_aligned_" + PRIMARY_INDEX + "__occupancy_MA.png", contrast=CONTRAST_NAMES),
            expand(PROJ + "/report/{contrast}_aligned_" + PRIMARY_INDEX + "__occupancy_volcano.png", contrast=CONTRAST_NAMES)
        ]
    output:
        report  = SEQ_DATE + "_" + PROJ + "_" + PRIMARY_INDEX + "_qc_analysis.html",
        reportc = PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_pipeline_methods.txt",
        config  = temp(PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_" + PRIMARY_INDEX + "_config.yaml"),
        result  = temp(PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_" + PRIMARY_INDEX + "_clean_results.tsv")
    params:
        job_name  = PROJ + "_qc_html",
        cmdd     = PROJ + "/pipeline",
        out_file  = SEQ_DATE + "_" + PROJ + "_" + PRIMARY_INDEX + "_qc_analysis",
        script  = "workflow/scripts/multiqc_config.R",
        seqdate = SEQ_DATE,
        mydir   = PROJ,
        index   = PRIMARY_INDEX
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 1, 1)
    threads:
        1
    shell:
        """
        echo "Pipeline run: $(date '+%Y-%m-%d %H:%M:%S')" >> {output.reportc}
        echo "" >> {output.reportc}
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.aggregate_cmds("{params.cmdd}", "{output.reportc}")
EOF
        Rscript {params.script} "{input.tsv}" "{params.mydir}" "{params.seqdate}" "{params.index}" "{output.result}" "{output.config}"
        multiqc {params.mydir} --config {output.config} --force --filename {params.out_file}
        rm -r {params.out_file}_data
        rm -f {PROJ}/pipeline/*.lock
        """
