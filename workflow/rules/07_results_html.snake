

rule create_plots:
    input:
        PROJ + "/report/" + PROJ + "_" + INDEXES[0] + "_results.tsv",
        sorted(list(set([
            PROJ + f"/heatmap/{row['Region']}_{group}_aligned_{row['Index']}__{row['Value']}_norm_{row['Suffix']}_{sense_asense}_heatmap.png"
            for _, row in DF_SAM_NORM.iterrows()
            for group in GROUPS.keys()
            for sense_asense in SENSE_ASENSE
            if str(row['Region']) in HEATMAP_REGIONS  # Explicit whitelist
        ])))
    output:
        report  = SEQ_DATE + "_" + PROJ + "_" + INDEXES[0] + "_qc_plots_analysis.html",
        reportc = PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_pipeline_methods.txt",
        config  = temp(PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_" + INDEXES[0] + "_config.yaml"),
        result  = temp(PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_" + INDEXES[0] + "_clean_results.tsv")
    params:
        job_name   = PROJ + "_qc_plots_html",
        cmdd     = PROJ + "/pipeline",
        out_file  = SEQ_DATE + "_" + PROJ + "_" + INDEXES[0] + "_qc_plots_analysis",
        script  = "workflow/scripts/multiqc_config.R",
        seqdate = SEQ_DATE,
        mydir   = PROJ,
        index   = INDEXES[0]
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 2, 4) # multiplier, min, max, unit=GB
    threads:
        1
    shell:
        """
        echo "Pipeline run: $(date '+%Y-%m-%d %H:%M:%S')" >> {output.reportc}
        echo "" >> {output.reportc}
        python - << 'EOF'
import sys
sys.path.insert(0, "workflow/scripts/")
import funs
funs.aggregate_cmds("{params.cmdd}", "{output.reportc}")
EOF
        Rscript {params.script} "{input}" "{params.mydir}" "{params.seqdate}" "{params.index}" "{output.result}" "{output.config}"
        multiqc {params.mydir} --config {output.config} --force --filename {params.out_file}
        rm -r {params.out_file}_data
        rm -f {PROJ}/pipeline/*.lock

        ARCHIVE_DIR="{params.mydir}/report/$(date '+%Y%m%d_%H%M%S')"
        mkdir -p "$ARCHIVE_DIR"
        cp "{output.report}" "{output.reportc}" "$ARCHIVE_DIR"/
        """
        