

rule create_plots:
    input:
        PROJ + "/report/" + PROJ + "_" + INDEXES[0] + "_results.tsv",
        expand(PROJ + "/report/" + PROJ + "_{genelist}_{region}_{index}_norm_{suffix}_heatmap.pdf",
               genelist=GENELIST,
               region=[r for r in REGIONS if r in HEATMAP_REGIONS], 
               index=INDEXES,
               suffix=DF_SAM_NORM['Suffix'].unique())
    output:
        report  = SEQ_DATE + "_" + PROJ + "_" + INDEXES[0] + "_qc_plots_analysis.html",
        reportc = PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "pipeline_methods.txt",
        config  = temp(PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_" + INDEXES[0] + "_config.yaml"),
        result  = temp(PROJ + "/report/" + SEQ_DATE + "_" + PROJ + "_" + INDEXES[0] + "_clean_results.tsv")
    params:
        job_name   = PROJ + "_qc_plots_html",
        cmdd     = PROJ + "/pipeline",
        out_file  = SEQ_DATE + "_" + PROJ + "_" + INDEXES[0] + "_qc_plots_analysis",
        script  = "workflow/scripts/multiqc_config.R",
        seqdate = SEQ_DATE,
        mydir   = PROJ,
        index   = INDEXES[0]
    resources:
        memory   = lambda wildcards, input: memory_estimator(input, 2, 4) # multiplier, min, max, unit=GB
    threads:
        1
    shell:
        """
        echo "Pipeline run: $(date '+%Y-%m-%d %H:%M:%S')" >> {output.reportc}
        echo "" >> {output.reportc}
        ls -tr {params.cmdd} | xargs cat >> {output.reportc}
        Rscript {params.script} "{input}" "{params.mydir}" "{params.seqdate}" "{params.index}" "{output.result}" "{output.config}"
        multiqc {params.mydir} --config {output.config} --force --filename {params.out_file}
        rm -r {params.out_file}_data
        """
        